# ── API Keys ─────────────────────────────────────────────────────────────
# OpenRouter (https://openrouter.ai/keys) — used by openrouter_client.py
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenAI — used by openai_client.py
# OPENAI_API_KEY=sk-...

# Anthropic — used by anthropic_client.py
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — used by gemini_client.py
# GEMINI_API_KEY=...

# ngrok — used to expose MCP server publicly for Anthropic
# NGROK_AUTHTOKEN=...

# ── Hugging Face ─────────────────────────────────────────────────────────
# Required for downloading the encrypted dataset and private models
# HF_TOKEN=hf_...
# HF_HOME=/path/to/hf/cache
